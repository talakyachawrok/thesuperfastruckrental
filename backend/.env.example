# ==========================================
# SuperFast Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB connection string:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/superfast?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/superfast?retryWrites=true&w=majority

# JWT Secret Key for Authentication
# Generate a strong 32+ character random string
JWT_SECRET=your_jwt_secret_key_change_in_production

# Default Logistics Operating Region
DEFAULT_REGION=Assam
